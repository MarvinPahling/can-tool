{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM"],
		"module": "ESNext",
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",

		/* Path aliases */
		"paths": {
			"@/*": ["./src/*"]
		},

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src"],
	// Both generated and unimported: the api layer pulls `commands`/`types`
	// directly rather than through the barrel, and the query hooks call `listen`
	// themselves (matching useCanFrames) rather than using the event helpers.
	// `events.ts` ships an unused type import that would trip noUnusedLocals,
	// and generated files must never be hand-edited.
	"exclude": ["src/generated/index.ts", "src/generated/events.ts"],
	"references": [{ "path": "./tsconfig.node.json" }]
}
