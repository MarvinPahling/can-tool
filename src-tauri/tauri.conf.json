{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "CAN Tool",
	"version": "0.1.0",
	"identifier": "de.marvin.can-tool",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "CAN Tool",
				"width": 800,
				"height": 600,
				"maximized": true,
				"decorations": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"typegen": {
			"projectPath": ".",
			"outputPath": "../src/generated",
			"validationLibrary": "zod",
			"verbose": false
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
